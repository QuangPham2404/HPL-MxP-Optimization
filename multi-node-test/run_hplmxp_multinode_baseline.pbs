#!/bin/bash
# HPL-MxP multinode baseline run, parametrized by GPU count per node.
# Expected working directory: multi-node-test/ on GAAS (contains rsh_pbsdsh_container.sh).
# Inputs: PBS select=N:ngpus=G (place=scatter) plus qsub -v "LABEL=..,GPUS=..".
# Outputs: attempt-specific PBS stdout/stderr under outputs/ (passed via qsub).
# Assumptions: the approved container + modules exist; rsh_pbsdsh_container.sh is present.
#
# This script runs the same HPL-MxP baseline parameters on any N x G layout.
# It only validates the multi-node launch/transport; performance is not the goal.
# Launch model: Approach 1 (container mpirun + rsh_pbsdsh_container.sh bridge).

#PBS -N HPL_MXP_MULTINODE
#PBS -q gpu_as
#PBS -P hpc_admin
#PBS -l place=scatter
#PBS -l walltime=00:30:00

set -euo pipefail

cd "$PBS_O_WORKDIR"

LABEL="${LABEL:-unknown}"
GPUS="${GPUS:-}"
N="${N:-120000}"
NB="${NB:-1024}"
NPORDER="${NPORDER:-row}"

if [ -z "$GPUS" ]; then
  echo "ERROR: GPUS (GPUs per node) must be provided via -v GPUS=<int>" >&2
  exit 1
fi

module purge
module load apptainer/1.4.1
module load nvhpc/26.3
module load squashfuse/0.5.2
module load gocryptfs/2.5.0

chmod +x "$PWD/rsh_pbsdsh_container.sh"

SIF="/home/pham0094/hpl_hpcg_hplmxp_container/hpc-benchmarks_26.02.sif"
RSH_AGENT="$PWD/rsh_pbsdsh_container.sh"

# Allocation geometry: one rank per GPU, G ranks per node.
NNODES=$(sort -u "$PBS_NODEFILE" | wc -l)
NPROCS=$((NNODES * GPUS))

# GPU affinity maps node-local rank 0..G-1 to local GPUs 0..G-1.
GPU_AFFINITY=$(seq -s: 0 $((GPUS - 1)))

# Process grid: nprow x npcol = NPROCS, with npcol >= nprow (square-ish,
# matching the single-node baseline's "rows <= columns" convention).
NPCOL=$(awk -v r="$NPROCS" 'BEGIN {
  n = int(sqrt(r)); if (n*n < r) n++;
  for (c = n; c <= r; c++) { if (r % c == 0) { print c; exit } }
}')
NPROW=$((NPROCS / NPCOL))

# De-duplicated hostfile with explicit per-node slot count (reliable for any G).
awk -v g="$GPUS" '
  { sub(/\r$/, ""); if (!seen[$0]++) print $0 " slots=" g }
' "$PBS_NODEFILE" > "$PWD/hostfile"

echo "experiment_id=hplmxp-multinode-baseline"
echo "attempt=${LABEL}"
echo "pbs_job_id=${PBS_JOBID:-unknown}"
echo "submitted_workdir=$PWD"
echo "layout=${NNODES} nodes x ${GPUS} GPUs = ${NPROCS} ranks"
echo "nodes=$(sort -u "$PBS_NODEFILE" | paste -sd' ')"
echo "grid=nprow=${NPROW} npcol=${NPCOL} order=${NPORDER}"
echo "n=${N} nb=${NB}"
echo "gpu_affinity=${GPU_AFFINITY}"
echo "=== hostfile ==="
cat "$PWD/hostfile"

# Container's own mpirun drives the cross-node spawn via the pbsdsh bridge that
# launches the remote orted inside the container (Approach 1, consistent MPI
# end-to-end). Bind /opt/pbs + /var/spool/pbs so pbsdsh works inside the container.
apptainer exec --nv \
  -B /opt/pbs:/opt/pbs \
  -B /var/spool/pbs:/var/spool/pbs \
  -B "$PWD":"$PWD" \
  "$SIF" \
  /usr/local/mpi/bin/mpirun -np "$NPROCS" \
    --hostfile "$PWD/hostfile" \
    --mca plm_rsh_agent "$RSH_AGENT" \
    --mca plm_rsh_no_tree_spawn 1 \
    --mca plm_rsh_num_concurrent 1 \
    --mca routed direct \
    -x PATH -x LD_LIBRARY_PATH \
    --bind-to none \
    /workspace/hpl-mxp.sh \
      --gpu-affinity "$GPU_AFFINITY" \
      --nprow "$NPROW" \
      --npcol "$NPCOL" \
      --nporder "$NPORDER" \
      --n "$N" \
      --nb "$NB" \
      --skip-tests 1 \
      --monitor-gpu 1 \
      --monitor-gpu-interval 10 \
      --monitor-gpu-pcie-width-warning 16 \
      --monitor-gpu-pcie-gen-warning 5

echo "=== HPL-MxP multinode baseline complete: ${LABEL} ==="